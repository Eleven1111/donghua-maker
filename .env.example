# Copy to ~/.config/donghua/.env (chmod 600) — or to .env in your film folder — and fill in only what you use.
# Every key is optional: films, free edge-tts narration, fonts and Mixkit sounds work with none of them.
# Lookup order: environment → ./.env → ~/.config/donghua/.env → ~/.config/secrets/.env

# MiniMax paid narration (voice.py). Mainland account: leave MINIMAX_API_BASE unset; international: https://api.minimax.io
MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io
# MINIMAX_TTS_MODEL=           # defaults to the model named in references/narration.md

# Extra sound-effect source (sfx_search.py): free key at https://freesound.org/apiv2/apply
FREESOUND_API_KEY=

# Fonts when GitHub is slow or blocked: a folder holding the .ttf files, or a URL prefix that proxies GitHub
# DONGHUA_FONT_DIR=~/Fonts/donghua
# DONGHUA_FONT_MIRROR=

# Background music SoundFont (music_render.py)
# SOUNDFONT=~/.local/share/soundfonts/GeneralUser-GS.sf2
